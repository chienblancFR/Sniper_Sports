# Tennis — moteur + futur sniper (sans secrets)
# Cibles : moneyline + total de jeux (O/U). ATP best-of-3 en priorité pour 2027.

# --- Elo surface (tennis_ratings.py) ---
TENNIS_ELO_BASE=1500
TENNIS_ELO_K=32
# Part de l'Elo surface vs Elo global dans la note match (0.70 = 70 % surface)
TENNIS_ELO_SURFACE_BLEND=0.70

# --- Point / service → total jeux (tennis_model.py) ---
# Moyenne circuit des points gagnés au service (à recalibrer sur Sackmann)
TENNIS_MU_SERVE_HARD=0.64
TENNIS_MU_SERVE_CLAY=0.62
TENNIS_MU_SERVE_GRASS=0.66
TENNIS_MU_SERVE_CARPET=0.65
TENNIS_ELO_POINT_SCALE=400
# Proxy Elo→service (ablation si TENNIS_SERVE_SOURCE=elo_proxy)
TENNIS_POINT_SENSITIVITY=0.55

# --- Stats service PIT (Sackmann) ---
# stats = effets α/γ + compteurs ; elo_proxy = mapping Elo seul
TENNIS_SERVE_SOURCE=stats
TENNIS_SERVE_N_PRIOR=40
TENNIS_SERVE_SURFACE_BLEND=0.70
# true = p = μ + α_serveur − γ_retourneur (ridge PIT)
TENNIS_SERVE_OPP_ADJ=true
# Amplifie (α − γ) ; 2.0 ≈ biais totaux ~0 (grille 2022-26)
TENNIS_SERVE_EFFECT_SCALE=2.0
# Filet Elo sur l'écart (0 = opp-adj pur)
TENNIS_SERVE_ELO_SPREAD_WEIGHT=0.0

# --- Split 1er / 2e service : p = f*p1 + (1-f)*p2 ---
TENNIS_SERVE_SPLIT=true
TENNIS_MU_1ST_IN_HARD=0.621
TENNIS_MU_1ST_IN_CLAY=0.627
TENNIS_MU_1ST_IN_GRASS=0.627
TENNIS_MU_1ST_IN_CARPET=0.624
TENNIS_MU_1ST_WON_HARD=0.727
TENNIS_MU_1ST_WON_CLAY=0.687
TENNIS_MU_1ST_WON_GRASS=0.741
TENNIS_MU_1ST_WON_CARPET=0.720
TENNIS_MU_2ND_WON_HARD=0.507
TENNIS_MU_2ND_WON_CLAY=0.504
TENNIS_MU_2ND_WON_GRASS=0.520
TENNIS_MU_2ND_WON_CARPET=0.510

# --- Moneyline vs totaux ---
# elo (défaut) | engine | blend — ML officielle séparée du moteur jeux
TENNIS_ML_SOURCE=elo
# Si blend : p_ml = (1-w)*Elo + w*moteur
TENNIS_ML_BLEND_ENGINE=0.0

# --- Blend modèle × Pinnacle no-vig (sniper) ---
# p_final = (1-λ)*p_model + λ*p_shin ; λ élevé = moins de faux edges
TENNIS_MARKET_BLEND=true
TENNIS_MARKET_BLEND_ML=0.70
TENNIS_MARKET_BLEND_OU=0.70

# --- Marchés ---
TENNIS_BEST_OF_DEFAULT=3
# Lignes O/U jeux évaluées par défaut (séparées par des virgules)
TENNIS_TOTAL_GAMES_LINES=20.5,21.5,22.0,22.5,23.5
TENNIS_EDGE_MIN=0.03

# --- Calibration O/U (fit warm-up / historique, appliqué éval + sniper) ---
# none | isotonic | platt
TENNIS_TOTALS_CALIB=isotonic
TENNIS_TOTALS_CALIB_BANDS=true
TENNIS_TOTALS_CALIB_MIN_SAMPLES=80

# --- Calibration P(3 sets) / longueur (corrige raccourcissement des gros favoris) ---
# none | isotonic | platt | band_offset
TENNIS_SETS_CALIB=isotonic
TENNIS_SETS_COND_SHIFT=true
TENNIS_SETS_CALIB_MIN_SAMPLES=80

# --- Tie-break dédié (totaux 22–24 / sets serrés) ---
TENNIS_TB_DEDICATED=true
# Compresse l'écart SPW en TB (0.5 calibre favori ~55%)
TENNIS_TB_SERVE_SCALE=0.50
TENNIS_TB_MU_SHIFT=0.0
# none | isotonic | platt
TENNIS_TB_CALIB=platt
TENNIS_TB_CALIB_MIN_SAMPLES=80

# --- Vague A4 : break-back (dépendance jeu-à-jeu) ---
# Après un break, hold suivant × (1-ρ) ; 0 = i.i.d.
TENNIS_BREAK_BACK=0.08

# --- Vague A5 : fiabilité Elo + élargissement PMF ---
TENNIS_ELO_N_PRIOR=15
# Largeur PMF jeux × (1-rel) ; 0 = off
TENNIS_PMF_SIGMA=1.5

# --- Vague A6 : fatigue (repos + minutes match précédent) ---
TENNIS_FATIGUE=true
TENNIS_FATIGUE_SCALE=0.015
TENNIS_FATIGUE_MIN_THRESH=120
TENNIS_FATIGUE_REST_DAYS=2

# --- Vague A7 : CLV paper (pré-tip only — jamais de cotes live) ---
TENNIS_CLV_TRACK=true
# Écart max relatif prise→close ; au-delà = blowout live ignoré / réparé
TENNIS_CLV_MAX_DEV_REL=0.35

# --- Ops / paper (tennis_sniper.py) ---
TENNIS_DRY_RUN=true
TENNIS_BANKROLL=1000
# Scan Odds : tip dans ≤ N h (observation + edges loggés hors prise)
TENNIS_SCAN_HEURES_AVANCE=18
# Prise paper : uniquement entre MIN et MAX heures avant tip
TENNIS_PRISE_HEURES_MAX=6
TENNIS_PRISE_HEURES_MIN=3
# Filet : jamais de prise dans les N min avant tip
TENNIS_MINUTES_AVANT_TIP=10
TENNIS_LOOP_SECONDS=300
TENNIS_KELLY_FRACTION=0.25
TENNIS_MISE_MAX_PCT=0.02
TENNIS_BOOKMAKER=pinnacle
TENNIS_REGIONS=eu
# Prefixe Odds API des tournois scannes (ATP only en v1)
TENNIS_TOUR_PREFIX=tennis_atp_
TENNIS_STATE_CACHE_HOURS=24
# Boucle Always-on : recheck CSV + Elo toutes les N h
TENNIS_STATE_RELOAD_HOURS=12
TENNIS_JOURNAL_FILE=journal_trading_tennis.csv
# Sur PA : écrit automatiquement dans /home/chienblanc/data/ + miroir ~/
# Dashboard Streamlit Cloud lit :
#   https://chienblanc.pythonanywhere.com/data/journal_trading_tennis.csv
# Override local / URL :
# TENNIS_JOURNAL_CSV=C:/chemin/local/journal_trading_tennis.csv
# TENNIS_JOURNAL_URL=https://chienblanc.pythonanywhere.com/data/journal_trading_tennis.csv
# Si sniper en local (pas Always-on) : PA_FTP_USER / PA_FTP_PASSWORD dans env/common.env
# Canal Telegram dédié ; vide = repli TELEGRAM_* de common.env
TENNIS_TELEGRAM_TOKEN=
TENNIS_TELEGRAM_CHAT_ID=

# --- Data Sackmann (miroir : upstream tennis_atp 404 depuis 2026) ---
# Attribution CC BY-NC-SA 4.0 — Jeff Sackmann ; ne pas committer les CSV
TENNIS_SACKMANN_DIR=data/tennis/sackmann
TENNIS_SACKMANN_SOURCE=https://raw.githubusercontent.com/Aneeshers/tennis-sackmann-archive/main/atp
TENNIS_SACKMANN_YEARS=2018-2026
# Auto : re-télécharge CSV année courante si age ≥ N h, puis rebuild Elo
TENNIS_SACKMANN_AUTO_REFRESH=true
TENNIS_SACKMANN_REFRESH_HOURS=12
# Warm-up Elo exclus de l'éval (année civile inclusive)
TENNIS_CALIB_WARMUP_UNTIL=2021
# 3 = best-of-3 seulement pour les métriques (Elo MAJ sur tous les formats)
TENNIS_CALIB_BEST_OF=3

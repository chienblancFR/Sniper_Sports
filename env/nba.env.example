# NBA — nba_sniper.py (sans secrets)
# Saison en cours, convention "année de fin" (ex. 2027 = saison 2026-27, comme NHL_SEASON)
NBA_SEASON=2027
# TTL cache disque team_game_logs/schedule pour la saison en cours (saisons terminées = cache permanent)
NBA_PIT_CACHE_JOURS=1
# Retry/backoff stats.nba.com (timeouts transitoires observés en exploration sur ScoreboardV3/ScheduleLeagueV2)
NBA_API_MAX_RETRIES=3
NBA_API_TIMEOUT=30
NBA_API_RETRY_BACKOFF=2.0

# nba_params.py — moteur mathématique (defaults, surchargés par nba_params_tuned.json)
# Shrinkage bayésien vers la moyenne ligue (poids en "matchs équivalents")
NBA_N_PRIOR_DEFAULT=15
# Décroissance temporelle des ratings ORtg/DRtg/Pace (jours, 0 = désactivé)
NBA_RATING_HALF_LIFE_JOURS=45
# GP comptés pour la confiance pleine saison en cours vs prior saison N-1
NBA_BLEND_GP_PLEIN=20
# Home court advantage (fraction symétrique ORtg+/DRtg- domicile)
NBA_HCA_DEFAULT=0.015
# Pénalité back-to-back (2e soir consécutif) : attaque -X% / défense +X%
NBA_B2B_ATK_PCT=0.015
NBA_B2B_DEF_PCT=0.015
# Bonus attaque si repos >= 2 jours (pas de B2B)
NBA_REST_BONUS_PCT=0.005
# Bonus altitude équipe domicile (Denver ~1600m) + malus visiteur
NBA_ALTITUDE_BONUS=0.01
NBA_ALTITUDE_TEAMS=DEN
# Distribution bivariée Normale marge/total : écart-type points/équipe/match, corrélation scores dom/ext
NBA_SIGMA_TEAM_DEFAULT=12.5
NBA_RHO_SCORES_DEFAULT=0.20
# Fallback moyenne ligue si aucune équipe n'a encore joué cette saison
NBA_LEAGUE_AVG_RTG_DEFAULT=114.0
NBA_LEAGUE_AVG_PACE_DEFAULT=99.0
# Fichier JSON de surcharges calibrées (backtest_nba.py --tune, phase ultérieure)
NBA_PARAMS_TUNED_FILE=nba_params_tuned.json
